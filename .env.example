# ============================================================
# CraftifyX Miner 7.0 — 环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env
# 警告: .env 已在 .gitignore 中, 切勿提交到 Git!
# ============================================================

# --- PostgreSQL ---
# 命名约定：POSTGRES_DB / POSTGRES_USER 须与 DATABASE_URL 中的库名、用户名一致（见 docs/LOCAL_DEVELOPMENT.md）
POSTGRES_DB=craftifyx_miner
POSTGRES_USER=miner
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://miner:CHANGE_ME@localhost:5432/craftifyx_miner

# --- Apify ---
APIFY_API_TOKEN=apify_api_CHANGE_ME
APIFY_WEBHOOK_SECRET=CHANGE_ME

# --- 国产大模型 (统一网关: 阿里云百炼, 推荐) ---
DASHSCOPE_API_KEY=sk-CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主力模型选择 (按测试结果确定)
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.5-plus
LLM_BATCH_SIZE=50

# --- 备选: Kimi / Moonshot 直连 ---
MOONSHOT_API_KEY=sk-CHANGE_ME
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# --- 备选: DeepSeek 直连 ---
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Flask ---
FLASK_SECRET_KEY=CHANGE_ME
FLASK_PORT=5000

# --- JWT (deploy.sh 自动生成，无需手动填写) ---
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRY_HOURS=24

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- 成本控制 ---
MONTHLY_BUDGET_USD=500
DAILY_APIFY_BUDGET_USD=20
MONTHLY_LLM_BUDGET_USD=10

# --- 发现 / 深度抓取（生产可调大；冒烟建议 MAX_FOLLOWING_PER_ANCHOR=40、DEEP_SCRAPE_BATCH_SIZE=3）---
DAILY_ANCHOR_COUNT=20
MAX_FOLLOWING_PER_ANCHOR=500
DEEP_SCRAPE_BATCH_SIZE=50

# --- 备份 ---
BACKUP_RETENTION_DAYS=7
