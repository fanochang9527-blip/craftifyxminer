# ============================================================
# CraftifyX Miner 6.0 — 环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env
# 警告: .env 已在 .gitignore 中, 切勿提交到 Git!
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://miner:CHANGE_ME@localhost:5432/craftifyx_miner
DB_PASSWORD=CHANGE_ME

# --- Apify ---
APIFY_API_TOKEN=apify_api_CHANGE_ME
APIFY_WEBHOOK_SECRET=CHANGE_ME

# --- 国产大模型 (统一网关: 阿里云百炼, 推荐) ---
DASHSCOPE_API_KEY=sk-CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主力模型选择 (按测试结果确定)
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.5-plus
LLM_BATCH_SIZE=50

# --- 备选: Kimi / Moonshot 直连 ---
MOONSHOT_API_KEY=sk-CHANGE_ME
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# --- 备选: DeepSeek 直连 ---
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 备选: 智谱 GLM 直连 ---
ZHIPU_API_KEY=CHANGE_ME
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- 备选: MiniMax 直连 ---
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# --- Flask ---
FLASK_SECRET_KEY=CHANGE_ME
FLASK_PORT=5000

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- 成本控制 ---
DAILY_APIFY_BUDGET_USD=20
MONTHLY_LLM_BUDGET_USD=10
