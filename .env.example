# ============================================================
# CraftifyX Miner 7.0 — 环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env
# 警告: .env 已在 .gitignore 中, 切勿提交到 Git!
# ============================================================

# --- PostgreSQL ---
# 命名约定：POSTGRES_DB / POSTGRES_USER 须与 DATABASE_URL 中的库名、用户名一致（见 docs/LOCAL_DEVELOPMENT.md）
POSTGRES_DB=craftifyx_miner
POSTGRES_USER=miner
DB_PASSWORD=CHANGE_ME
# 本机直接跑 Python（venv）时用 localhost。docker compose 会在 compose.yml 里覆盖为 host `db`，勿改此处即可
DATABASE_URL=postgresql://miner:CHANGE_ME@localhost:5432/craftifyx_miner

# Docker 构建：默认使用阿里云 Debian 源，减轻 deb.debian.org CDN 502（海外构建可设 APT_USE_MIRROR=0）
#APT_USE_MIRROR=1
# 镜像站 429 无法拉 bookworm 时，可改用已缓存的 slim：
#PYTHON_BASE=python:3.11-slim

# --- Apify ---
APIFY_API_TOKEN=apify_api_CHANGE_ME
APIFY_WEBHOOK_SECRET=CHANGE_ME

# --- LLM 主力: Kimi / Moonshot ---
# 本地（大陆 key）: MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# ECS / 国际站 key: MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=sk-CHANGE_ME
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

LLM_PROVIDER=moonshot
LLM_MODEL=kimi-k2.5
# Moonshot/Kimi 模型 ID（与控制台一致，例如 kimi-k2.5）
MOONSHOT_MODEL=kimi-k2.5
LLM_BATCH_SIZE=20
LLM_TIMEOUT=120

# 仅 Kimi: moonshot（默认）。需要备选时再写: moonshot,deepseek,dashscope
# 只有配了有效 key 的 provider 会参与；401/403 立即换下一个，不重试
LLM_FALLBACK_CHAIN=moonshot

# --- 备选: DeepSeek 直连 ---
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 备选: 阿里云百炼 (DashScope) ---
# 按 ECS 所在区域选择端点:
# 中国大陆: https://dashscope.aliyuncs.com/compatible-mode/v1
# 香港:     https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡:   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Flask ---
FLASK_SECRET_KEY=CHANGE_ME
# docker-compose：映射 宿主机 FLASK_PORT -> 容器 5000。若本机 5000 被占用（macOS AirPlay/Control Center 常见），改为 5001 等
FLASK_PORT=5000

# --- JWT (deploy.sh 自动生成，无需手动填写) ---
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRY_HOURS=24

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- 成本控制 ---
MONTHLY_BUDGET_USD=500
DAILY_APIFY_BUDGET_USD=40
MONTHLY_LLM_BUDGET_USD=10
# 开发环境建议设为 true，超 Apify 日预算后阻断流水线；线上保持 false（默认只警告不阻断）
APIFY_BUDGET_HARD_LIMIT=false

# --- 发现 / 深度抓取（生产可调大；冒烟建议 MAX_FOLLOWING_PER_ANCHOR=40、DEEP_SCRAPE_BATCH_SIZE=3）---
DAILY_ANCHOR_COUNT=20
MAX_FOLLOWING_PER_ANCHOR=500
DEEP_SCRAPE_BATCH_SIZE=300

# --- 锚点扫描轮换 ---
# 高价值锚点（is_seed=true）冷却期（天）
ANCHOR_HIGH_VALUE_COOLDOWN_DAYS=3
# 次高价值锚点（bd_status=interested）冷却期（天）
ANCHOR_NORMAL_COOLDOWN_DAYS=7
# 普通锚点（bd_status=rejected_unfit）冷却期（天）
ANCHOR_LOW_VALUE_COOLDOWN_DAYS=14

# --- 双模型口径 ---
# sellability_score >= 阈值 => 建议联系
SELLABILITY_SCORE_THRESHOLD=60
# 初始训练打标：total_sales > 阈值为正样本，< 阈值为负样本（=阈值不参与）
SELLABILITY_LABEL_SALES_THRESHOLD=50
# SPS 评分映射：sps = clamp(predicted_sales / SPS_SALES_NORMALIZER, 0, 100)
SPS_SALES_NORMALIZER=100
# 工作台灰度阶段：1=仅展示新字段；2=默认双模型筛选/排序
BD_WORKBENCH_PHASE=1
# 非 sellable 候选在双模型排序时的 SPS 降权系数（0-1，越小降权越强）
NON_SELLABLE_SPS_WEIGHT=0.35

# --- 备份 ---
BACKUP_RETENTION_DAYS=7

# --- Growth Score ---
GROWTH_SPAN_MIN_DAYS=30
GROWTH_ANOMALY_DROP_THRESHOLD=-0.80
GROWTH_ANOMALY_MIN_FOLLOWERS=1000
FOLLOWER_REFRESH_INTERVAL_DAYS=3
FOLLOWER_REFRESH_BATCH_SIZE=100

# --- 粉丝量急剧下降预警 ---
FOLLOWER_DROP_ALERT_THRESHOLD=-0.20
FOLLOWER_DROP_MIN_FOLLOWERS=20000

# --- 种子粉丝量大幅增长提醒 ---
SEED_GROWTH_ALERT_THRESHOLD=0.20
SEED_GROWTH_MIN_FOLLOWERS=20000
